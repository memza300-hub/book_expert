# Скопировать в .env на сервере и заполнить. Файл .env в git не попадает.
DB_USERNAME=postgres
DB_PASSWORD=change-me
# Сгенерировать: docker compose run --rm web ./bin/rails secret
SECRET_KEY_BASE=change-me
# true — если есть домен и HTTPS через Nginx; false — доступ по IP без TLS
RAILS_FORCE_SSL=false
# true — один раз, чтобы загрузить демо-данные (3 жанра, 10 книг, expert@example.com)
SEED_ON_START=false
